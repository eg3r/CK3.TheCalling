vbox = {
	name = "decision_view_widget_tc_call_options"
	layoutpolicy_horizontal = expanding
	margin = { 15 5 }
	spacing = 2

	text_label_left = {
		layoutpolicy_horizontal = expanding
		text = "tc_call_ui_age"
	}
	hbox = {
		layoutpolicy_horizontal = expanding
		margin_left = 10
		margin_bottom = 4
		spacing = 14
		button_radio_label = {
			onclick = "[GetScriptedGui('tc_call_set_age_20').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			blockoverride "radio" {
				frame = "[BoolTo1And2( GetScriptedGui('tc_call_is_age_20').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			}
			blockoverride "text" {
				text = "tc_call_ui_age_20"
				max_width = 110
				fontsize_min = 11
			}
		}
		button_radio_label = {
			onclick = "[GetScriptedGui('tc_call_set_age_25').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			blockoverride "radio" {
				frame = "[BoolTo1And2( GetScriptedGui('tc_call_is_age_25').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			}
			blockoverride "text" {
				text = "tc_call_ui_age_25"
				max_width = 110
				fontsize_min = 11
			}
		}
		button_radio_label = {
			onclick = "[GetScriptedGui('tc_call_set_age_30').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			blockoverride "radio" {
				frame = "[BoolTo1And2( GetScriptedGui('tc_call_is_age_30').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			}
			blockoverride "text" {
				text = "tc_call_ui_age_30"
				max_width = 110
				fontsize_min = 11
			}
		}
		button_radio_label = {
			onclick = "[GetScriptedGui('tc_call_set_age_40').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			blockoverride "radio" {
				frame = "[BoolTo1And2( GetScriptedGui('tc_call_is_age_40').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			}
			blockoverride "text" {
				text = "tc_call_ui_age_40"
				max_width = 110
				fontsize_min = 11
			}
		}
		expand = {}
	}

